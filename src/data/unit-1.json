      "common_mistakes": [
        {
          "wrong": "{{Good night}}, {{Sara}}! (عند لقاء صديقتك في المساء)",
          "right": "{{Good evening, Sara!}}",
          "explain_ar": "عند مقابلة شخص في المساء نقول {{Good evening}}. أما {{Good night}} فتُستخدم غالبًا عند الوداع أو قبل النوم. ويمكن استخدام {{Hello}} للتحية في أوقات مختلفة."
        },
        {
          "wrong": "{{Good morning}}! (بعد الظهر)",
          "right": "{{Good afternoon!}}",
          "explain_ar": "{{Good morning}} تُقال في الصباح، و{{Good afternoon}} تُقال بعد الظهر، و{{Good evening}} تُقال في المساء عند اللقاء."
